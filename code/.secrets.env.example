# Template for code/.secrets.env (which is gitignored and stays on your machine).
# Copy this file to code/.secrets.env and fill in only the providers you use.
# Get keys from: Gemini https://aistudio.google.com/apikey | OpenAI
# https://platform.openai.com/api-keys | DeepSeek https://platform.deepseek.com
# Ollama (local) needs NO key — just `ollama serve` running.
# Usage: `source code/.secrets.env` before any live command.

export GEMINI_API_KEY=PASTE_YOUR_KEY_HERE
# export OPENAI_API_KEY=PASTE_YOUR_KEY_HERE
# export DEEPSEEK_API_KEY=PASTE_YOUR_KEY_HERE
